<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    
    <style name="Theme.Caller" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/dark_app_background</item>
        <item name="android:navigationBarColor">@color/dark_app_background</item>
    </style>

    <style name="Theme.Caller.CallScreen" parent="Theme.Caller">
        <item name="android:windowBackground">@drawable/call_screen_window_background</item>
        <item name="android:windowAnimationStyle">@style/AnimationCallerNoAnimation</item>
    </style>

    <style name="AnimationCallerNoAnimation">
        <item name="android:activityOpenEnterAnimation">@anim/no_animation</item>
        <item name="android:activityOpenExitAnimation">@anim/no_animation</item>
        <item name="android:activityCloseEnterAnimation">@anim/no_animation</item>
        <item name="android:activityCloseExitAnimation">@anim/no_animation</item>
    </style>

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/dark_app_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_phone_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Caller</item>

        <!-- Explicit Android 12+ / ColorOS framework splash attributes -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/dark_app_background</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/ic_launcher_phone_foreground</item>
        <!-- CRITICAL for Oppo/ColorOS: Force icon to display even on warm starts when dialer process is already running -->
        <item name="android:windowSplashScreenBehavior" tools:targetApi="33">icon_preferred</item>
    </style>
    
</resources>
