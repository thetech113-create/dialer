<?xml version="1.0" encoding="utf-8"?>
<!-- Debug/test build (com.caller.test): account type matches BuildConfig.APPLICATION_ID + ".backup"
     in code, so the test app owns its own authenticator and does not collide with the released app. -->
<account-authenticator xmlns:android="http://schemas.android.com/apk/res/android"
    android:accountType="com.caller.test.backup"
    android:icon="@mipmap/ic_launcher"
    android:smallIcon="@mipmap/ic_launcher"
    android:label="@string/app_name" />
